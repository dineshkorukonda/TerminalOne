---
const shells = [
  {
    id: 'powershell',
    name: 'PowerShell',
    description: 'For Windows commands and automation.',
    detail: 'Work with scripts, files, and development tools.',
  },
  {
    id: 'cmd',
    name: 'CMD',
    description: 'For command-line tools and batch scripts.',
    detail: 'Use familiar Windows commands in a shared workspace.',
  },
  {
    id: 'bash',
    name: 'Git Bash',
    description: 'For Git and familiar Bash commands.',
    detail: 'Use Bash commands from the same TerminalOne prompt.',
  },
];
---

<div class="preview-composition" data-terminal-preview>
  <div class="preview-topline">
    <span>ONE TERMINAL / AUTOMATIC SHELL SELECTION</span>
    <span>DESIGN CONCEPT</span>
  </div>
  <div class="workspace-showcase">
    <div class="workspace-sidebar">
      <span class="workspace-label">EXPLORE SHELL EXAMPLES</span>
      <div
        class="shell-tabs"
        role="tablist"
        aria-label="Automatic shell selection concept examples"
        hidden
      >
        {shells.map((shell, index) => (
          <button
            id={'tab-' + shell.id}
            role="tab"
            type="button"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={'panel-' + shell.id}
            tabindex={index === 0 ? 0 : -1}
            data-shell={shell.id}
          >
            <span class="shell-number" aria-hidden="true">
              0{index + 1}
            </span>
            {shell.name}
            <span class="shell-arrow" aria-hidden="true">
              ↗
            </span>
          </button>
        ))}
      </div>
      <p>
        You enter a command.
        <br />
        TerminalOne selects the shell.
      </p>
    </div>
    <div class="workspace-stage">
      {shells.map((shell, index) => (
        <div
          class="shell-workspace"
          id={'panel-' + shell.id}
          role="tabpanel"
          aria-labelledby={'tab-' + shell.id}
          tabindex="0"
          hidden={index !== 0}
        >
          <span class="workspace-label">THE SHELL BEHIND YOUR COMMAND</span>
          <h2>{shell.name}</h2>
          <p>{shell.description}</p>
          <span class="workspace-detail">{shell.detail}</span>
          <div class="workspace-architecture" aria-hidden="true">
            <span>LOCAL</span>
            <i></i>
            <span>WINDOWS</span>
            <i></i>
            <span>YOUR SHELL</span>
          </div>
        </div>
      ))}
      <div class="workspace-status">
        <span>TerminalOne</span>
        <span>ONE CONTINUOUS WORKFLOW</span>
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-terminal-preview]');
  if (root) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
    );
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, position) => {
        const active = position === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel, position) => {
        panel.hidden = position !== index;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        let next: number;
        switch (event.key) {
          case 'ArrowRight':
            next = (index + 1) % tabs.length;
            break;
          case 'ArrowLeft':
            next = (index - 1 + tabs.length) % tabs.length;
            break;
          case 'Home':
            next = 0;
            break;
          case 'End':
            next = tabs.length - 1;
            break;
          default:
            return;
        }
        event.preventDefault();
        select(next, true);
      });
    });
    const tablist = root.querySelector<HTMLElement>('[role="tablist"]');
    if (tablist) tablist.hidden = false;
  }
</script>
