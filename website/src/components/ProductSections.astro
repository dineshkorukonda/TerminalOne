---
import {
  AppWindow,
  Layers,
  ShieldCheck,
  ArrowRight,
  Check,
  GitBranch,
} from '@lucide/astro';

const principles = [
  {
    number: '01',
    icon: AppWindow,
    title: 'One place for every command.',
    text: 'Keep Bash, CMD, and PowerShell commands in one terminal, without moving between shells yourself.',
  },
  {
    number: '02',
    icon: Layers,
    title: 'The right shell, automatically.',
    text: 'TerminalOne is designed to recognize supported commands and choose the appropriate shell for you.',
  },
  {
    number: '03',
    icon: ShieldCheck,
    title: 'A Unix-like flow on Windows.',
    text: 'A continuous command-line workflow for your local tools and files, with access to the Windows shells you already use.',
  },
];
const questions = [
  {
    question: 'What is TerminalOne?',
    answer: 'An all-in-one terminal for Windows.',
    detail:
      'It is being built to choose the shell based on your command, bringing a Unix-like command-line experience to Windows.',
  },
  {
    question: 'What would I use it for?',
    answer: 'Everyday command-line work.',
    detail:
      'Run development tools, work with Git, manage files, and keep separate tasks organized in one workspace.',
  },
  {
    question: 'Do I need to switch shells myself?',
    answer: 'Automatic shell selection is the core idea.',
    detail:
      'You type a command in TerminalOne. For supported commands, it is designed to choose Bash, CMD, or PowerShell and show the result in the same terminal.',
  },
  {
    question: 'Can I download TerminalOne today?',
    answer: 'Not yet. TerminalOne is in development.',
    detail:
      'There is no published installer. The desktop supports native shell sessions, tabs, split panes, and appearance settings. Automatic shell selection based on your command is still in development.',
  },
  {
    question: 'How is TerminalOne licensed?',
    answer: 'TerminalOne uses the MIT license.',
    detail:
      'You can find the license and source code in the GitHub repository.',
  },
];
---

<section
  class="shell-strip container"
  aria-label="Shells TerminalOne is designed to select automatically"
>
  <span class="section-kicker">
    One command line.
    <br />
    <span>The shell is handled for you.</span>
  </span>
  <div class="shell-name">PowerShell</div>
  <div class="shell-name">Command Prompt</div>
  <div class="shell-name">
    <GitBranch size={23} stroke-width={1.5} aria-hidden="true" /> Git Bash
  </div>
  <span class="shell-strip-note">Designed for Windows</span>
</section>

<section id="features" class="section container vision-section" tabindex="-1">
  <div class="section-heading">
    <div>
      <span class="eyebrow">
        <span class="tiny-square"></span> HOW IT WORKS
      </span>
      <h2>
        Your tools.
        <br />
        <span class="muted-text">One workspace.</span>
      </h2>
    </div>
    <p>
      Enter a command. TerminalOne is designed to identify the right shell, run
      supported commands through it, and bring the result back to the same
      terminal.
    </p>
  </div>
  <div class="principle-grid">
    {principles.map(({ number, icon: Icon, title, text }) => (
      <article class="principle-card">
        <div class="card-top">
          <Icon size={23} stroke-width={1.5} aria-hidden="true" />
          <span>{number}</span>
        </div>
        <h3>{title}</h3>
        <p>{text}</p>
      </article>
    ))}
  </div>
</section>

<section
  id="faq"
  class="section container faq-section"
  aria-labelledby="faq-title"
>
  <div>
    <span class="eyebrow">
      <span class="tiny-square"></span> A FEW ANSWERS
    </span>
    <h2 id="faq-title">
      Before the
      <br />
      <span class="muted-text">first command.</span>
    </h2>
  </div>
  <div class="faq-list">
    {questions.map(({ question, answer, detail }) => (
      <details>
        <summary>
          {question}
          <span class="faq-toggle" aria-hidden="true">
            +
          </span>
        </summary>
        <div class="faq-answer">
          <p>{answer}</p>
          <p>{detail}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<section class="container final-cta">
  <span class="eyebrow">TERMINALONE FOR WINDOWS.</span>
  <h2>
    A home for
    <br />
    <span>your command line.</span>
  </h2>
  <p>
    Explore TerminalOne on GitHub.
    <br />
    In development. No installer available yet.
  </p>
  <a
    class="button button-primary"
    href="https://github.com/dineshkorukonda/TerminalOne"
  >
    View on GitHub <ArrowRight size={16} aria-hidden="true" />
  </a>
  <div class="cta-notes">
    <span>
      <Check size={12} aria-hidden="true" /> MIT licensed
    </span>
    <span>
      <Check size={12} aria-hidden="true" /> Designed for Windows
    </span>
    <span>
      <Check size={12} aria-hidden="true" /> In development
    </span>
  </div>
</section>
