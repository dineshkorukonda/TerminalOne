---
import {
  AppWindow,
  Layers,
  ShieldCheck,
  ArrowRight,
  Check,
  GitBranch,
} from '@lucide/astro';

const principles = [
  {
    number: '01',
    icon: AppWindow,
    title: 'Bash, ready to work.',
    text: 'With Git for Windows installed, get syntax highlighting, Tab completion, and suggestions in Git Bash. Your existing dotfiles stay yours.',
  },
  {
    number: '02',
    icon: Layers,
    title: 'Windows commands, in reach.',
    text: 'Use selected PowerShell commands and CMD directory listings from Bash. Choose a shell profile for your other scripts.',
  },
  {
    number: '03',
    icon: ShieldCheck,
    title: 'Room for every task.',
    text: 'Organize native shell sessions with tabs, split panes, project folders, and appearance settings. Keep your tools and files local.',
  },
];
const questions = [
  {
    question: 'What is TerminalOne?',
    answer: 'An all-in-one terminal for Windows.',
    detail:
      'The Windows x64 alpha brings Git Bash, PowerShell, and CMD into a shared workspace with tabs and split panes.',
  },
  {
    question: 'What would I use it for?',
    answer: 'Everyday command-line work.',
    detail:
      'Run development tools, work with Git, manage files, and keep separate tasks organized in one workspace.',
  },
  {
    question: 'Do I need to switch shells myself?',
    answer: 'Supported Windows commands can run from Bash.',
    detail:
      'The alpha routes a small set of missing PowerShell commands and specific CMD dir forms from Git Bash. Bash quoting rules apply. For arbitrary PowerShell scripts, CMD syntax, or shell state changes, choose the explicit shell profile.',
  },
  {
    question: 'Can I download TerminalOne today?',
    answer: 'Yes. A Windows x64 alpha is available.',
    detail:
      'Find the experimental unsigned installer in the download section, with matching checksums and release notes. The app includes its runtime; Git Bash is an optional separate installation. This alpha is intended for testing and feedback.',
  },
  {
    question: 'How is TerminalOne licensed?',
    answer: 'TerminalOne uses the MIT license.',
    detail:
      'You can find the license and source code in the GitHub repository.',
  },
];
---

<section class="shell-strip container" aria-label="Available shell profiles">
  <span class="section-kicker">
    Three shell profiles.
    <br />
    <span>One local workspace.</span>
  </span>
  <div class="shell-name">PowerShell</div>
  <div class="shell-name">Command Prompt</div>
  <div class="shell-name">
    <GitBranch size={23} stroke-width={1.5} aria-hidden="true" /> Git Bash
  </div>
  <span class="shell-strip-note">Designed for Windows</span>
</section>

<section id="features" class="section container vision-section" tabindex="-1">
  <div class="section-heading">
    <div>
      <span class="eyebrow">
        <span class="tiny-square"></span> HOW IT WORKS
      </span>
      <h2>
        Your tools.
        <br />
        <span class="muted-text">One workspace.</span>
      </h2>
    </div>
    <p>
      Start with assisted Bash, reach supported Windows commands through
      adapters, or choose PowerShell and CMD directly. Keep separate tasks
      together with tabs and split panes.
    </p>
  </div>
  <div class="principle-grid">
    {principles.map(({ number, icon: Icon, title, text }) => (
      <article class="principle-card">
        <div class="card-top">
          <Icon size={23} stroke-width={1.5} aria-hidden="true" />
          <span>{number}</span>
        </div>
        <h3>{title}</h3>
        <p>{text}</p>
      </article>
    ))}
  </div>
</section>

<section
  id="faq"
  class="section container faq-section"
  aria-labelledby="faq-title"
>
  <div>
    <span class="eyebrow">
      <span class="tiny-square"></span> A FEW ANSWERS
    </span>
    <h2 id="faq-title">
      Before the
      <br />
      <span class="muted-text">first command.</span>
    </h2>
  </div>
  <div class="faq-list">
    {questions.map(({ question, answer, detail }) => (
      <details>
        <summary>
          {question}
          <span class="faq-toggle" aria-hidden="true">
            +
          </span>
        </summary>
        <div class="faq-answer">
          <p>{answer}</p>
          <p>{detail}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<section class="container final-cta">
  <span class="eyebrow">TERMINALONE FOR WINDOWS.</span>
  <h2>
    A home for
    <br />
    <span>your command line.</span>
  </h2>
  <p>
    Try the Windows x64 alpha.
    <br />
    Experimental, unsigned, and ready for your feedback.
  </p>
  <a class="button button-primary" href="#download">
    Download alpha <ArrowRight size={16} aria-hidden="true" />
  </a>
  <div class="cta-notes">
    <span>
      <Check size={12} aria-hidden="true" /> MIT licensed
    </span>
    <span>
      <Check size={12} aria-hidden="true" /> Designed for Windows
    </span>
    <span>
      <Check size={12} aria-hidden="true" /> Alpha available
    </span>
  </div>
</section>
