---
import { ArrowRight, ArrowUpRight, Monitor } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TerminalPreview from '../components/TerminalPreview.astro';
import ProductSections from '../components/ProductSections.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AlphaDownload from '../components/AlphaDownload.astro';
---

<SiteLayout>
  <SiteHeader />
  <main id="main" tabindex="-1">
    <section class="hero container">
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="status-dot"></span> TERMINALONE / BUILT FOR WINDOWS
        </div>
        <h1>
          One terminal.
          <br /> <span>Every shell.</span>
        </h1>
        <p class="hero-description">
          A Windows terminal for Git Bash, PowerShell, and CMD. Start in Bash
          with syntax highlighting and suggestions, and run supported Windows
          commands from the same prompt.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#download">
            Download alpha <ArrowRight size={16} aria-hidden="true" />
          </a>
          <a
            class="button button-quiet"
            href="https://github.com/dineshkorukonda/TerminalOne"
          >
            View on GitHub <ArrowUpRight size={15} aria-hidden="true" />
          </a>
        </div>
        <div class="hero-meta">
          <span>
            <Monitor size={13} aria-hidden="true" /> Made for Windows
          </span>
          <span class="meta-divider">/</span>
          <span>MIT licensed</span>
          <span class="development-label">Alpha available</span>
        </div>
      </div>
      <TerminalPreview />
      <div class="hero-bottom">
        <span>YOUR SHELLS. ONE WINDOWS WORKSPACE.</span>
        <a href="#features" aria-label="Explore the workspace">
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>
    <AlphaDownload />
    <ProductSections />
  </main>
  <SiteFooter />
</SiteLayout>
