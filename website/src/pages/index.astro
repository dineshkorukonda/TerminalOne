---
import { ArrowRight, ArrowUpRight, Monitor } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TerminalPreview from '../components/TerminalPreview.astro';
import ProductSections from '../components/ProductSections.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<SiteLayout>
  <SiteHeader />
  <main id="main" tabindex="-1">
    <section class="hero container">
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="status-dot"></span> TERMINALONE / BUILT FOR WINDOWS
        </div>
        <h1>
          One terminal.
          <br /> <span>Every shell.</span>
        </h1>
        <p class="hero-description">
          An all-in-one terminal for Windows. Type your command; TerminalOne is
          designed to choose between Bash, CMD, and PowerShell automatically. A
          Unix-like experience, without switching shells yourself.
        </p>
        <div class="hero-actions">
          <a
            class="button button-primary"
            href="https://github.com/dineshkorukonda/TerminalOne"
          >
            View on GitHub <ArrowRight size={16} aria-hidden="true" />
          </a>
          <a class="button button-quiet" href="#features">
            Meet TerminalOne <ArrowUpRight size={15} aria-hidden="true" />
          </a>
        </div>
        <div class="hero-meta">
          <span>
            <Monitor size={13} aria-hidden="true" /> Made for Windows
          </span>
          <span class="meta-divider">/</span>
          <span>MIT licensed</span>
          <span class="development-label">In development</span>
        </div>
      </div>
      <TerminalPreview />
      <div class="hero-bottom">
        <span>YOU TYPE THE COMMAND. TERMINALONE CHOOSES THE SHELL.</span>
        <a href="#features" aria-label="Explore the workspace">
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>
    <ProductSections />
  </main>
  <SiteFooter />
</SiteLayout>
