---
import { ArrowRight, ArrowUpRight, Monitor, Terminal } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TerminalPreview from '../components/TerminalPreview.astro';
import ProductSections from '../components/ProductSections.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<SiteLayout>
  <SiteHeader />
  <main id="main" tabindex="-1">
    <section class="hero container">
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="status-dot"></span> WINDOWS-NATIVE. DEVELOPER-FIRST.
        </div>
        <h1>
          One terminal.
          <br /> <span>Every shell.</span>
        </h1>
        <p class="hero-description">
          A new home for your command line.
          <br />
          Familiar shells. Thoughtful design.
          <br />A workflow that feels like yours.
        </p>
        <div class="hero-actions">
          <a
            class="button button-primary"
            href="https://github.com/dineshkorukonda/Terminal/milestones"
          >
            Follow the build <ArrowRight size={16} aria-hidden="true" />
          </a>
          <a class="button button-quiet" href="#vision">
            Meet TerminalOne <ArrowUpRight size={15} aria-hidden="true" />
          </a>
        </div>
        <div class="hero-meta">
          <span>
            <Monitor size={13} aria-hidden="true" /> Made for Windows
          </span>
          <span class="meta-divider">/</span>
          <span>MIT licensed</span>
          <span class="development-label">In development</span>
        </div>
      </div>
      <TerminalPreview />
      <div class="hero-bottom">
        <span>
          <Terminal size={13} aria-hidden="true" /> FAMILIAR WHERE IT MATTERS.
          DIFFERENT WHERE IT COUNTS.
        </span>
        <a href="#vision" aria-label="Explore the vision">
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>
    <ProductSections />
  </main>
  <SiteFooter />
</SiteLayout>
