{
  "name": "terminal-one",
  "version": "0.1.0",
  "description": "Terminal One desktop application",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "electron:install": "install-electron",
    "predev": "npm run electron:install",
    "dev": "electron-vite dev",
    "prestart": "npm run electron:install",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "test:smoke": "npm run electron:install && npm run build && playwright test",
    "lint:boundaries": "eslint src --max-warnings 0",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "test:unit": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "staged": "lint-staged",
    "commitlint": "commitlint",
    "check:pr-title": "node scripts/check-pr-title.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
